# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=sb_publishable_<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=sb_secret_<your-service-role-key>

# ── LLM / AI ─────────────────────────────────────────────────────────────────
# Fallback chain: Google → Anthropic → OpenAI
# Only providers with an API key are added to the chain.
LLM_TEMPERATURE=0.2

# Google Gemini (primary)
GEMINI_API_KEY=AIzaSy<your-gemini-api-key>
GEMINI_MODEL=gemini-2.0-flash

# Anthropic (fallback #2)
ANTHROPIC_API_KEY=sk-ant-<your-anthropic-api-key>
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI (fallback #3)
OPENAI_API_KEY=sk-<your-openai-api-key>
OPENAI_MODEL=gpt-4o-mini

# ── Voice ─────────────────────────────────────────────────────────────────────
# Groq — used for speech-to-text (Whisper), NOT for the LLM chat chain
GROQ_API_KEY=gsk_<your-groq-api-key>

# ElevenLabs — used for text-to-speech
ELEVENLABS_API_KEY=sk_<your-elevenlabs-api-key>

# ── MCP Server ───────────────────────────────────────────────────────────────
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
